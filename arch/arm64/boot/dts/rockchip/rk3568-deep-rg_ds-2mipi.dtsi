			29 00 02 30 00
			15 FF 02 11 00
			15 00 02 36 03
			15 FF 02 29 00
		];

		panel-exit-sequence = [
			05 40 01 28
			05 78 01 10
		];

		disp_timings1: display-timings {
			native-mode = <&dsi1_timing0>;
			dsi1_timing0: timing0 {
				clock-frequency = <62800000>;
				hactive = <1024>;
				vactive = <768>;

				hsync-len = <80>;//19
				hback-porch = <80>;//40
				hfront-porch = <120>;//123

				vsync-len = <8>;
				vback-porch = <8>;
				vfront-porch = <16>;

				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <1>;
			};
		};
#endif
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				panel_in_dsi1: endpoint {
					remote-endpoint = <&dsi1_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi1_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi1>;
			};
		};
	};
};

/*
 * video_phy1 needs to be enabled
 * when dsi1 is enabled
 */
&dsi1 {
	status = "okay";
};

&video_phy1 {
	status = "okay";
};

&route_dsi1 {
	status = "okay";
	logo,uboot  = "logo.bmp";
	logo,kernel = "logo.bmp";
	connect = <&vp1_out_dsi1>;
};
&dsi1_in_vp0 {
	status = "disabled";
};
&dsi1_in_vp1 {
	status = "okay";
};
#else
&dsi1 {
	status = "disabled";
};

&dsi1_in_vp0 {
	status = "disabled";
};

&dsi1_in_vp1 {
	status = "disabled";
};
#endif

&hdmi {
	status = "disabled";
};

&hdmi_in_vp0 {
	status = "disabled";
};

&hdmi_in_vp1 {
	status = "disabled";
};

&hdmi_sound {
	status = "disabled";
};

//&route_hdmi {
//	status = "disabled";
//	connect = <&vp0_out_hdmi>;
//};

&i2c3 {
	status = "disabled"; //i2c@fe5c0000
	clock-frequency = <400000>;
	i2c-scl-rising-time-ns = <144>;
	i2c-scl-falling-time-ns = <4>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m0_xfer>;
	
#if 0
	gt9xx_1: gt9xx-1@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		touch-gpio = <&gpio0 RK_PC0 1>; //tp_irq
		reset-gpio = <&gpio0 RK_PB7 0>;
		max-x = <640>;
		max-y = <480>;
		tp-size = <911>; //89 101 910 ..
		ext_lcd_tp = <1>;
		flip_report_tp = <1>;
		com_lcd_tp = <0>;	
		pinctrl-names = "default";
		pinctrl-0 = <&touch1_gt_gpio>;
		status = "disabled";
		//rockchip,panel-notifier = <&dsi0_panel>;
	};

	gt9xx_1: gt9xx-1@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC0 IRQ_TYPE_LEVEL_LOW>;
 
		irq-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
		panel = <&dsi1_panel>;
		reset-gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		touchscreen-size-x = <640>;
		touchscreen-size-y = <480>;
		touchscreen-inverted-x;
		touchscreen-inverted-y;
 
		pinctrl-names = "default";
		pinctrl-0 = <&touch1_gt_gpio>;
		//status = "disabled";
		//rockchip,panel-notifier = <&dsi0_panel>;
	};
#endif
};

&i2c5 {
	status = "okay"; //i2c@fe5e0000
	clock-frequency = <200000>; //400000
	i2c-scl-rising-time-ns = <144>;
	i2c-scl-falling-time-ns = <4>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5m0_xfer>; //v1 pcb-i2c5m1_xfer,v2 pcb-i2c5m0_xfer
	
	/* bottom touch */
#if 1 //ok
	gt9xx_0: gt9xx-0@14 {
		compatible = "goodix,gt9xx";
		reg = <0x14>;
		touch-gpio = <&gpio0 RK_PC6 1>; //tp_irq
		reset-gpio = <&gpio0 RK_PA6 0>;
		max-x = <1024>;
		max-y = <768>;
		tp-size = <911>;  //ic:89 101 910 ..
		ext_lcd_tp = <0>;
		flip_report_tp = <0>;
		com_lcd_tp = <0>;	
		pinctrl-names = "default";
		pinctrl-0 = <&touch0_gt_gpio>;
		//status = "disabled";
		//rockchip,panel-notifier = <&dsi0_panel>;
	};
#else
	gt9xx_0: gt9xx-0@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC6 IRQ_TYPE_LEVEL_LOW>;
 
		irq-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
		panel = <&dsi0_panel>;
		reset-gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		touchscreen-size-x = <1>;
		touchscreen-size-y = <480>;
		
		pinctrl-names = "default";
		pinctrl-0 = <&touch0_gt_gpio>;
		//status = "disabled";
		status = "okay";
		//rockchip,panel-notifier = <&dsi0_panel>;
	};
#endif

#if 0
	gt1x: gt1x@14 {
		compatible = "goodix,gt1x";
		reg = <0x14>;
		//power-supply = <&vcc3v3_lcd0_n>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_gpio>;
		goodix,rst-gpio = <&gpio0 RK_PB6 GPIO_ACTIVE_HIGH>;
		goodix,irq-gpio = <&gpio0 RK_PB5 IRQ_TYPE_LEVEL_LOW>;
	};
#endif
#if 0
	husb311@4E {
		compatible = "hynetek,husb311";
		reg = <0x4E>;
		//pinctrl-names = "default";
		status = "okay";
		vbus-supply = <&reg_drivevbus>;
	};
#endif
};

&pinctrl {
	tp {
		touch0_gt_gpio: touch0-gt-gpio {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>,
							<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;				
		};
	#if 0		
		touch1_gt_gpio: touch1-gt-gpio {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>,
							<0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;				
		};
	#endif		
	};

	lcd {
		lcd0_backlight_pwr_en: lcd0-backlight-pwr-en {
			rockchip,pins = <4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		lcd1_backlight_pwr_en: lcd1-backlight-pwr-en {
			rockchip,pins = <4 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		vcc3v3_lcd0_n_en: vcc3v3-lcd0-n-en {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		vcc3v3_lcd1_n_en: vcc3v3-lcd1-n-en {
			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		
		lcd0_rst_gpio: lcd0-rst-gpio {
			rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd0_enable_gpio: lcd0-enable-gpio {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd1_rst_gpio: lcd1-rst-gpio {
			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd1_enable_gpio: lcd1-enable-gpio {
			rockchip,pins = <0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pwm1 {
	pinctrl-0 = <&pwm1m1_pins>;
	status = "okay";
};

&pwm2 {
	pinctrl-0 = <&pwm2m1_pins>;
	status = "okay";
};

&pwm14 {
	pinctrl-0 = <&pwm14m0_pins>;
	status = "okay";
};