		panel-exit-sequence = [
			05 40 01 28
			05 78 01 10
		];

		disp_timings1: display-timings {
			native-mode = <&dsi1_timing0>;
			dsi1_timing0: timing0 {
				clock-frequency = <42100000>;
				hactive = <640>;
				vactive = <480>;

				hsync-len = <220>;//19
				hback-porch = <260>;//40
				hfront-porch = <260>;//123

				vsync-len = <2>;
				vback-porch = <16>;
				vfront-porch = <10>;

				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <1>;
			};
		};
