		panel-exit-sequence = [
			05 40 01 28
			05 78 01 10
		];

		//panel-read-id-sequence = [
		//	05 00 02 00 00
		//];

		disp_timings0: display-timings {
			native-mode = <&dsi0_timing0>;
			dsi0_timing0: timing0 {
			//clock = (hactive + hfp+hbp+hsync)*(vactive + vfp+vbp+vsync)*fps
			//保留两位有效数字（不要四舍五入），后面数据直接填0
				clock-frequency = <42100000>; //30m--58000000 must >25M
				hactive = <640>;
				vactive = <480>;

				hsync-len = <220>;//19
				hback-porch = <260>;//40
				hfront-porch = <260>;//123

				vsync-len = <2>;
				vback-porch = <16>;
				vfront-porch = <10>;

				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <1>;
			};
		};
#else
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
			      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS)>;
