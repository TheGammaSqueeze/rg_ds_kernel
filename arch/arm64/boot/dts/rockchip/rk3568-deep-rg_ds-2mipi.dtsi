			29 00 02 30 0D
			29 00 02 10 0C
			29 00 02 11 0C
			29 00 02 12 0C
			29 00 02 13 0C
			29 00 02 30 00
			15 FF 02 11 00
			15 FF 02 29 00
		];

		panel-exit-sequence = [
			05 40 01 28
			05 78 01 10
		];

		//panel-read-id-sequence = [
		//	05 00 02 00 00
		//];

		disp_timings0: display-timings {
			native-mode = <&dsi0_timing0>;
			dsi0_timing0: timing0 {
			//clock = (hactive + hfp+hbp+hsync)*(vactive + vfp+vbp+vsync)*fps
			//保留两位有效数字（不要四舍五入），后面数据直接填0
				clock-frequency = <62800000>; //30m--58000000 must >25M
				hactive = <1024>;
				vactive = <768>;

				hsync-len = <80>;//19
				hback-porch = <80>;//40
				hfront-porch = <120>;//123

				vsync-len = <8>;
				vback-porch = <8>;
				vfront-porch = <16>;

				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <1>;
			};
		};
#endif
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi0: endpoint {
					remote-endpoint = <&dsi0_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi0_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi0>;
			};
		};
	};
};

/*
 * video_phy0 needs to be enabled
 * when dsi0 is enabled
 */
&dsi0 {
	status = "okay";
};
&video_phy0 {
	status = "okay";
};

&route_dsi0 {
	status = "okay";
	logo,uboot = "logo_kernel.bmp";
	logo,kernel = "logo_kernel.bmp";
	connect = <&vp0_out_dsi0>;
};
&dsi0_in_vp0 {
	status = "okay";
};

&dsi0_in_vp1 {
	status = "disabled";
};


