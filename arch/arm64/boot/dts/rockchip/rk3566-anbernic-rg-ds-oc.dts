	gpu_opp_table: opp-table-1 {
		compatible = "operating-points-v2";
		mbist-vmin = <0xc96a8 0xdbba0 0xe7ef0>;
		nvmem-cells = <&gpu_leakage &core_pvtm &mbist_vmin &gpu_opp_info &specification_serial_number &remark_spec_serial_number>;
		nvmem-cell-names = "leakage\0pvtm\0mbist-vmin\0opp-info\0specification_serial_number\0remark_spec_serial_number";
		rockchip,supported-hw;
		rockchip,temp-hysteresis = <0x1388>;
		rockchip,low-temp = <0x00>;
		rockchip,low-temp-adjust-volt = <0x00 0x320 0xc350>;
		rockchip,pvtm-voltage-sel = <0x00 0x14820 0x00 0x14821 0x153d8 0x01 0x153d9 0x16378 0x02 0x16379 0x186a0 0x03>;
		rockchip,pvtm-ch = <0x00 0x05>;
		phandle = <0x6d>;
		rockchip,avs-scale = <0x01>;
		rockchip,avs = <0x01>;
		rockchip,max-volt = <0x124f80>;

		opp-200000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0xbebc200>;
			opp-microvolt = <0xc96a8 0xc96a8 0xee098>;
		};

		opp-300000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x11e1a300>;
			opp-microvolt = <0xc96a8 0xc96a8 0xee098>;
		};

		opp-400000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x17d78400>;
			opp-microvolt = <0xc96a8 0xc96a8 0xee098>;
		};

		opp-600000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xd59f8 0xd59f8 0xee098>;
			opp-microvolt-L0 = <0xd59f8 0xd59f8 0xee098>;
			opp-microvolt-L1 = <0xcf850 0xcf850 0xee098>;
			opp-microvolt-L2 = <0xc96a8 0xc96a8 0xee098>;
			opp-microvolt-L3 = <0xc96a8 0xc96a8 0xee098>;
		};

		opp-700000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x29b92700>;
			opp-microvolt = <0xe1d48 0xe1d48 0xee098>;
			opp-microvolt-L0 = <0xe1d48 0xe1d48 0xee098>;
			opp-microvolt-L1 = <0xdbba0 0xdbba0 0xee098>;
			opp-microvolt-L2 = <0xd59f8 0xd59f8 0xee098>;
			opp-microvolt-L3 = <0xcf850 0xcf850 0xee098>;
		};

		opp-800000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x00 0x2faf0800>;
			opp-microvolt = <0xee098 0xee098 0x106738>;
			opp-microvolt-L0 = <0xee098 0xee098 0x106738>;
			opp-microvolt-L1 = <0xe7ef0 0xe7ef0 0x106738>;
			opp-microvolt-L2 = <0xe1d48 0xe1d48 0x106738>;
			opp-microvolt-L3 = <0xdbba0 0xdbba0 0x106738>;
		};

		opp-j-600000000 {
			opp-supported-hw = <0x04 0xffff>;
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xdbba0 0xdbba0 0xf4240>;
		};

		opp-m-800000000 {
			opp-supported-hw = <0x02 0xffff>;
			opp-hz = <0x00 0x2faf0800>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0xf4240>;
		};
	};

