	mipi_dsi0_power: mipi-dsi0-power-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 0x1b 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&mipi_dsi0_pwr_en>;
		regulator-name = "mipi_dsi0_power";
		regulator-always-on;
		status = "disabled";
		phandle = <0x328>;
	};

	mipi_dsi1_power: mipi-dsi1-power-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 0x1c 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&mipi_dsi1_pwr_en>;
		regulator-name = "mipi_dsi1_power";
		regulator-always-on;
		status = "disabled";
		phandle = <0x329>;
	};

	gpio_backlight: gpio-backlight {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&mipi_dsi0_pwr_en &mipi_dsi1_pwr_en>;
		phandle = <0x32a>;

		backlight_0: led@5 {
			gpios = <&gpio4 0x04 0x00>;
			label = "backlight_0_power";
			default-state = "on";
			phandle = <0x32b>;
		};

		backlight_1: led@6 {
			gpios = <&gpio4 0x03 0x00>;
			label = "backlight_1_power";
			default-state = "on";
			phandle = <0x32c>;
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 0x00>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;
		phandle = <0x32d>;

		vol-up-key {
			label = "home";
			linux,code = <0x9e>;
			press-threshold-microvolt = <0x6d6>;
		};
	};

	keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pwr_key &gpio_hall>;
		phandle = <0x32e>;

		vol-up-key {
			gpios = <&gpio3 0x02 0x01>;
			linux,code = <0x72>;
			label = "volume up";
		};

		vol-down-key {
			gpios = <&gpio3 0x01 0x01>;
			linux,code = <0x73>;
			label = "volume down";
		};

		hall-lid {
			label = "lid-switch";
			gpios = <&gpio0 0x13 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			wakeup-source;
			debounce-interval = <0x14>;
		};
	};

	joypad: singleadc-joypad {
		compatible = "singleadc-joypad";
		joypad-name = "retrogame_joypad";
		joypad-product = <0x1101>;
		joypad-revision = <0x100>;
		status = "okay";
		hw_pcb_info = <0x02>;
		pinctrl-names = "default";
		pinctrl-0 = <&btn_pins>;
		io-channel-names = "amux_adc";
		io-channels = <&saradc 0x03>;
		amux-count = <0x06>;
		amux-a-gpios = <&gpio3 0x12 0x01>;
		amux-b-gpios = <&gpio3 0x13 0x01>;
		amux-en-gpios = <&gpio3 0x11 0x01>;
		button-adc-scale = <0x01>;
		button-adc-deadzone = <0x01>;
		button-adc-fuzz = <0x01>;
		button-adc-flat = <0x01>;
		abs_x-p-tuning = <0x01>;
		abs_x-n-tuning = <0x01>;
		abs_y-p-tuning = <0x01>;
		abs_y-n-tuning = <0x01>;
		abs_rx-p-tuning = <0x01>;
		abs_rx-n-tuning = <0x01>;
		abs_ry-p-tuning = <0x01>;
		abs_ry-n-tuning = <0x01>;
		poll-interval = <0x02>;
		phandle = <0x32f>;

		sw1 {
			gpios = <&gpio2 0x1c 0x01>;
			label = "GPIO DPAD-UP";
			linux,input-type = <0x03>;
			linux,code = <0x11>;
			linux,abs-value = <0x02>;
		};

		sw2 {
			gpios = <&gpio2 0x1d 0x01>;
			label = "GPIO DPAD-DOWN";
			linux,input-type = <0x03>;
			linux,code = <0x11>;
			linux,abs-value = <0x01>;
		};

		sw3 {
			gpios = <&gpio2 0x1f 0x01>;
			label = "GPIO DPAD-LEFT";
			linux,input-type = <0x03>;
			linux,code = <0x10>;
			linux,abs-value = <0x02>;
		};

		sw4 {
			gpios = <&gpio2 0x1e 0x01>;
			label = "GPIO DPAD-RIGHT";
			linux,input-type = <0x03>;
			linux,code = <0x10>;
			linux,abs-value = <0x01>;
		};

		sw5 {
			gpios = <&gpio3 0x08 0x01>;
			label = "GPIO KEY BTN-A";
			linux,code = <0x134>;
		};

		sw6 {
			gpios = <&gpio3 0x10 0x01>;
			label = "GPIO BTN-B";
			linux,code = <0x131>;
		};

		sw7 {
			gpios = <&gpio3 0x07 0x01>;
			label = "GPIO BTN-X";
			linux,code = <0x133>;
		};

		sw8 {
			gpios = <&gpio3 0x0f 0x01>;
			label = "GPIO BTN-Y";
			linux,code = <0x130>;
		};

		sw9 {
			gpios = <&gpio3 0x0a 0x01>;
			label = "GPIO BTN_SELECT";
			linux,code = <0x13a>;
		};

		sw10 {
			gpios = <&gpio3 0x09 0x01>;
			label = "GPIO BTN_START";
			linux,code = <0x13b>;
		};

		sw12 {
			gpios = <&gpio3 0x03 0x01>;
			label = "GPIO BTN_TL";
			linux,code = <0x136>;
		};

		sw13 {
			gpios = <&gpio3 0x05 0x01>;
			label = "GPIO BTN_TR";
			linux,code = <0x137>;
		};

		sw14 {
			gpios = <&gpio3 0x04 0x01>;
			label = "GPIO BTN_TL2";
			linux,code = <0x138>;
		};

		sw15 {
			gpios = <&gpio3 0x06 0x01>;
			label = "GPIO BTN_TR2";
			linux,code = <0x139>;
		};

		sw16 {
			gpios = <&gpio2 0x1b 0x01>;
			label = "GPIO BTN_THUMBR";
			linux,code = <0x13e>;
		};

		sw17 {
			gpios = <&gpio2 0x1a 0x01>;
			label = "GPIO BTN_THUMBL";
			linux,code = <0x13d>;
		};

		sw18 {
			gpios = <&gpio3 0x00 0x01>;
			label = "GPIO HALL";
			linux,code = <0x43>;
		};

		sw19 {
			gpios = <&gpio2 0x19 0x01>;
			label = "GPIO BTN_MODE";
			linux,code = <0x13c>;
		};
	};

	leds: gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&leds_gpio>;
		phandle = <0x330>;

		led@1 {
			gpios = <&gpio0 0x14 0x00>;
			label = "battery_full";
			default-state = "off";
		};

		led@2 {
			gpios = <&gpio0 0x15 0x00>;
			label = "battery_charging";
			default-state = "off";
			retain-state-suspended;
		};

		led@3 {
			gpios = <&gpio0 0x16 0x00>;
			label = "low_power";
			default-state = "off";
		};

		led@4 {
			gpios = <&gpio0 0x00 0x00>;
			label = "wifi_reg";
			default-state = "on";
			retain-state-suspended;
		};
	};

	charge-animation {
		compatible = "rockchip,uboot-charge";
		rockchip,uboot-charge-on = <0x00>;
		rockchip,android-charge-on = <0x01>;
		rockchip,uboot-low-power-voltage = <0xe10>;
		rockchip,screen-on-voltage = <0xe10>;
		rockchip,uboot-exit-charge-level = <0x02>;
		rockchip,uboot-exit-charge-voltage = <0xe10>;
		rockchip,uboot-exit-charge-auto = <0x00>;
		status = "okay";
	};

	vccsys: vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v8_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x39fbc0>;
		regulator-max-microvolt = <0x39fbc0>;
		phandle = <0x3d>;
	};

	rk817-sound {
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-rk817";
		hp-det-gpio = <&gpio4 0x12 0x00>;
		io-channels = <&saradc 0x02>;
		io-channel-names = "adc-detect";
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;
		rockchip,format = "i2s";
		rockchip,mclk-fs = <0x100>;
		rockchip,cpu = <0x133>;
		rockchip,codec = <0x134>;
		pinctrl-names = "default";
		pinctrl-0 = <&hp_det>;

		play-pause-key {
			label = "playpause";
			linux,code = <0xa4>;
			press-threshold-microvolt = <0x7d0>;
		};
	};

	vibrator {
		compatible = "rk-vibrator-gpio";
		vibrator-gpio = <&gpio3 0x14 0x00>;
		status = "okay";
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		post-power-on-delay-ms = <0xc8>;
		reset-gpios = <&gpio4 0x02 0x01>;
		phandle = <0x81>;
	};

	vcc_sd: vcc-sd {
		compatible = "regulator-gpio";
		enable-active-low;
		enable-gpio = <&gpio0 0x05 0x01>;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc_sd_h>;
		regulator-name = "vcc_sd";
		states = <0x325aa0 0x00 0x325aa0 0x01>;
		phandle = <0xb7>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "ap6330";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>;
		WIFI,host_wake_irq = <0x44 0x01 0x00>;
		keep_wifi_power_on;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <&rk817 0x01>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0xc2 0x0d 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <&uart1m1_rtsn>;
		pinctrl-1 = <&uart1_gpios>;
		BT,reset_gpio = <0x3e 0x1d 0x00>;
		BT,wake_gpio = <0x3e 0x1b 0x00>;
		BT,wake_host_irq = <0x3e 0x1c 0x00>;
		status = "okay";
	};

	vcc5v0_usb: vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x13c>;
	};

	vcc5v0_otg: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		vin-supply = <&vcc5v0_usb>;
		phandle = <0x113>;
	};

};
