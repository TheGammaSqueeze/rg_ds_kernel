	usb_host0_ohci: usb@fd840000 {
		compatible = "generic-ohci";
		reg = <0x00 0xfd840000 0x00 0x40000>;
		interrupts = <0x00 0x83 0x04>;
		clocks = <&cru 0xbd &cru 0xbe &cru 0xbc &usb2phy1>;
		clock-names = "usbhost\0arbiter\0pclk\0utmi";
		phys = <&u2phy1_otg>;
		phy-names = "usb2-phy";
		status = "okay";
		phandle = <0x15f>;
