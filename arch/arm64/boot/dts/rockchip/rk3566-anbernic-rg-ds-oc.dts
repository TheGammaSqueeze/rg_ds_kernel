		clock-names = "i2c\0pclk";
		pinctrl-0 = <&i2c3m1_xfer>;
		pinctrl-names = "default";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		clock-frequency = <0x61a80>;
		i2c-scl-rising-time-ns = <0x90>;
		i2c-scl-falling-time-ns = <0x04>;
		phandle = <0x1bf>;

		gt9xx_1: gt9xx-1@14 {
			compatible = "goodix,gt9xx";
			reg = <0x14>;
			touch-gpio = <&gpio0 0x10 0x01>;
			reset-gpio = <&gpio0 0x0f 0x00>;
			max-x = <0x280>;
			max-y = <0x1e0>;
			tp-size = <0x38f>;
			ext_lcd_tp = <0x01>;
			/* The top panel's image is turned 180 degrees by SurfaceFlinger's physical
			 * orientation (persist.gsf.rot.1); the glass reports in the panel's scan
			 * frame, so the driver turns the coordinates to match. InputReader's
			 * per-device rotation prop does not take effect for this digitizer, so this
			 * flip is the one place the correction lives. */
			flip_report_tp = <0x01>;
			com_lcd_tp = <0x00>;
			pinctrl-names = "default";
			pinctrl-0 = <&touch1_gt_gpio>;
			rockchip,panel-notifier = <0xd9>;
			phandle = <0x1c0>;
		};
	};

