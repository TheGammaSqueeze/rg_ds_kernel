// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
// Anbernic RG DS (RK3566) board device tree - oc.
// NOTE: decompiled-derived from the shipped runtime DTB (flattened, numeric
// phandles). Buildable + inspectable source; a clean #include refactor is a
// documented follow-up. See RG_DS_OVERCLOCK.md for the OC (2160/900+UV) delta.
/dts-v1/;

/ {
	interrupt-parent = <&gic>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	compatible = "rockchip,rk3566-rk817-tablet\0rockchip,rk3566";
	model = "Anbernic RG DS (rk3568)";

	hpll_pinning {
		assigned-clocks = <&pmucru 0x02>;
		assigned-clock-rates = <0x29020c0>;
	};

