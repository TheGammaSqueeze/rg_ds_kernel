	vop: vop@fe040000 {
		compatible = "rockchip,rk3568-vop";
		reg = <0x00 0xfe040000 0x00 0x3000 0x00 0xfe044000 0x00 0x1000>;
		reg-names = "regs\0gamma_lut";
		interrupts = <0x00 0x94 0x04>;
		clocks = <&cru 0xdd &cru 0xde &cru 0xdf &cru 0xe0 &cru 0xe1>;
		clock-names = "aclk_vop\0hclk_vop\0dclk_vp0\0dclk_vp1\0dclk_vp2";
		rockchip,aclk-normal-mode-rates = <0x179a7b00>;
		rockchip,aclk-advanced-mode-rates = <0x1dcd6500>;
		operating-points-v2 = <&vop_opp_table>;
		iommus = <&vop_mmu>;
		power-domains = <&power 0x09>;
		rockchip,grf = <&grf>;
		status = "okay";
		support-multi-area;
		/*
		 * Sync VP0 and VP1 scanout starts (vop2_crtc_sync): drop both VPs
		 * to standby, wait for edpi_wms_fs, then release standby back-to-back
		 * under local_irq_save so both DSI panels start their frame together
		 * (both dclks share the PLL, so the alignment holds).  bit0=VP0,
		 * bit1=VP1 -> 0x3 syncs both.  Fixes the top/bottom inter-screen
		 * phase offset.  Verify: dmesg | grep "Sync crtc_mask" shows 0x3.
		 */
		rockchip,sync-vp-mask = /bits/ 8 <0x03>;
		assigned-clocks = <&cru 0xdf &cru 0xe0>;
		assigned-clock-parents = <&pmucru 0x02 &pmucru 0x02>;
		assigned-clock-rates = <0x29020c0 0x29020c0>;
		vop-supply = <&vdd_logic>;
		phandle = <0x193>;

		vop_out: ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x11>;

			vp0: port@0 {
				reg = <0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x194>;
				vp0_out_dsi0: endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <&dsi0_in_vp0>;
					phandle = <0x13>;
				};

				vp0_out_dsi1: endpoint@1 {
					reg = <0x01>;
					remote-endpoint = <&dsi1_in_vp0>;
					phandle = <0x9f>;
				};

				vp0_out_edp: endpoint@2 {
					reg = <0x02>;
					remote-endpoint = <&edp_in_vp0>;
					phandle = <0x15>;
				};

				vp0_out_hdmi: endpoint@3 {
					reg = <0x03>;
					remote-endpoint = <&hdmi_in_vp0>;
					phandle = <0x16>;
				};
			};

			vp1: port@1 {
				reg = <0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x195>;
				vp1_out_dsi0: endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <&dsi0_in_vp1>;
					phandle = <0x98>;
				};

				vp1_out_dsi1: endpoint@1 {
					reg = <0x01>;
					remote-endpoint = <&dsi1_in_vp1>;
					phandle = <0x14>;
				};

				vp1_out_edp: endpoint@2 {
					reg = <0x02>;
					remote-endpoint = <&edp_in_vp1>;
					phandle = <0xab>;
				};

				vp1_out_hdmi: endpoint@3 {
					reg = <0x03>;
					remote-endpoint = <&hdmi_in_vp1>;
					phandle = <0xa9>;
				};

				vp1_out_lvds: endpoint@4 {
					reg = <0x04>;
					remote-endpoint = <&lvds0_in_vp1>;
					phandle = <0x17>;
				};

				vp1_out_lvds1: endpoint@5 {
					reg = <0x05>;
					remote-endpoint = <&lvds1_in_vp1>;
					phandle = <0x37>;
				};
			};

			vp2: port@2 {
				reg = <0x02>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x196>;

				vp2_out_lvds: endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <&lvds0_in_vp2>;
					phandle = <0x34>;
				};

				vp2_out_rgb: endpoint@1 {
					reg = <0x01>;
					remote-endpoint = <&rgb_in_vp2>;
					phandle = <0x18>;
				};

				vp2_out_lvds1: endpoint@2 {
					reg = <0x02>;
					remote-endpoint = <&lvds1_in_vp2>;
					phandle = <0x38>;
				};
			};
		};
	};

	vop_opp_table: vop-opp-table {
		compatible = "operating-points-v2";
		nvmem-cells = <&log_leakage &core_pvtm>;
		nvmem-cell-names = "leakage\0pvtm";
		rockchip,leakage-voltage-sel = <0x01 0x50 0x00 0x51 0xfe 0x01>;
		rockchip,pvtm-voltage-sel = <0x00 0x14820 0x00 0x14821 0x186a0 0x01>;
		rockchip,pvtm-ch = <0x00 0x05>;
		phandle = <0x89>;

		opp-500000000 {
			opp-hz = <0x00 0x1dcd6500>;
			opp-microvolt = <0xe1d48 0xe1d48 0xf4240>;
			opp-microvolt-L0 = <0xe1d48 0xe1d48 0xf4240>;
			opp-microvolt-L1 = <0xdbba0 0xdbba0 0xf4240>;
		};
	};

	vop_mmu: iommu@fe043e00 {
		compatible = "rockchip,iommu-v2";
		reg = <0x00 0xfe043e00 0x00 0x100 0x00 0xfe043f00 0x00 0x100>;
		interrupts = <0x00 0x94 0x04>;
		interrupt-names = "vop_mmu";
		clocks = <&cru 0xdd &cru 0xde>;
		clock-names = "aclk\0iface";
		#iommu-cells = <0x00>;
		rockchip,disable-device-link-resume;
		status = "okay";
		phandle = <0x8a>;
	};

	dsi0: dsi@fe060000 {
		compatible = "rockchip,rk3568-mipi-dsi";
		reg = <0x00 0xfe060000 0x00 0x10000>;
		interrupts = <0x00 0x44 0x04>;
		clock-names = "pclk\0hclk";
		clocks = <&cru 0xe8 &cru 0xda>;
		phy-names = "dphy";
		phys = <&video_phy0>;
		power-domains = <&power 0x09>;
		reset-names = "apb";
		resets = <&cru 0x110>;
		rockchip,grf = <&grf>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x197>;

		ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			dsi0_in: port@0 {
				reg = <0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x198>;

				dsi0_in_vp0: endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <&vp0_out_dsi0>;
					status = "okay";
					phandle = <0x8b>;
				};

				dsi0_in_vp1: endpoint@1 {
					reg = <0x01>;
					remote-endpoint = <&vp1_out_dsi0>;
					status = "disabled";
					phandle = <0x8f>;
				};
			};

			port@1 {
				reg = <0x01>;

				dsi0_out_panel: endpoint {
					remote-endpoint = <&panel_in_dsi0>;
					phandle = <0x9e>;
				};
			};
		};

		dsi0_panel: panel@0 {
			compatible = "aoly,sl008pa21y1285-b00\0simple-panel-dsi";
			status = "okay";
			reg = <0x00>;
			num = <0x00>;
			backlight = <&backlight>;
			enable-gpios = <&gpio0 0x17 0x00>;
			enable1-gpios = <&gpio0 0x08 0x00>;
			reset-gpios = <&gpio0 0x0b 0x01>;
			pinctrl-names = "default";
			pinctrl-0 = <&lcd_enable_gpio &lcd_rst_gpio>;
			stbyb-delay-ms = <0x0a>;
			prepare-delay-ms = <0x0a>;
			reset-delay-ms = <0x0a>;
			init-delay-ms = <0x0a>;
			enable-delay-ms = <0x0a>;
			disable-delay-ms = <0x0a>;
			unprepare-delay-ms = <0x0a>;
			width-mm = <0xe5>;
			height-mm = <0x8f>;
			dsi,flags = <0x803>;
