		ethernet0 = "/ethernet@fe2a0000";
		lvds0 = "/syscon@fdc60000/lvds";
		lvds1 = "/syscon@fdc60000/lvds1";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00>;
			clocks = <&scmi_clk 0x00>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <0x04>;
			dynamic-power-coefficient = <0xbb>;
			cpu-supply = <&vdd_cpu>;
			phandle = <0x1f>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x100>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <0x04>;
			phandle = <0x20>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x200>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <0x04>;
			phandle = <0x21>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x300>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			operating-points-v2 = <&cpu0_opp_table>;
			cpu-idle-states = <0x04>;
			phandle = <0x22>;
		};

		idle-states {
			entry-method = "psci";

			CPU_SLEEP: cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x64>;
				exit-latency-us = <0x78>;
				min-residency-us = <0x3e8>;
				phandle = <0x04>;
			};
		};
	};

	cpu0_opp_table: opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;
		mbist-vmin = <0xc96a8 0xdbba0 0xe7ef0>;
		nvmem-cells = <&cpu_leakage &core_pvtm &mbist_vmin &cpu_opp_info &specification_serial_number &remark_spec_serial_number>;
		nvmem-cell-names = "leakage\0pvtm\0mbist-vmin\0opp-info\0specification_serial_number\0remark_spec_serial_number";
		rockchip,supported-hw;
		rockchip,pvtm-voltage-sel = <0x00 0x14820 0x00 0x14821 0x153d8 0x01 0x153d9 0x16378 0x02 0x16379 0x186a0 0x03>;
		rockchip,pvtm-freq = <0x639c0>;
		rockchip,pvtm-volt = <0xdbba0>;
		rockchip,pvtm-ch = <0x00 0x05>;
		rockchip,pvtm-sample-time = <0x3e8>;
		rockchip,pvtm-number = <0x0a>;
		rockchip,pvtm-error = <0x3e8>;
		rockchip,pvtm-ref-temp = <0x28>;
		rockchip,pvtm-temp-prop = <0x1a 0x1a>;
		rockchip,thermal-zone = "soc-thermal";
		rockchip,temp-hysteresis = <0x1388>;
		rockchip,low-temp = <0x00>;
		/* Cold boost: +75mV below 0C. Extended 1992 -> 2160MHz so it also covers
		 * the OC point. Every other OPP gets this boost AND sits at or above a
		 * mbist-vmin floor the kernel clamps to; 2160 is above every floor, so
		 * without this it was the one undervolted point with no cold margin at
		 * all. 0x870 = 2160. */
		rockchip,low-temp-adjust-volt = <0x00 0x870 0x124f8>;
		rockchip,avs-scale = <0x01>;
		rockchip,avs = <0x01>;
		rockchip,bin-scaling-sel = <0x00 0x0a 0x01 0x0a>;
		rockchip,max-volt = <0x124f80>;
		phandle = <0x03>;

		opp-408000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x18519600>;
			opp-microvolt = <0xb71b0 0xb71b0 0x112a88>;
			clock-latency-ns = <0x9c40>;
		};

		opp-600000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xbd358 0xbd358 0x112a88>;
			clock-latency-ns = <0x9c40>;
		};

		opp-816000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x30a32c00>;
			opp-microvolt = <0xbd358 0xbd358 0x112a88>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};

		opp-1104000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x41cdb400>;
			opp-microvolt = <0xbd358 0xbd358 0x112a88>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1416000000 {
			opp-supported-hw = <0xfb 0xffff>;
			opp-hz = <0x00 0x54667200>;
			opp-microvolt = <0xc96a8 0xc96a8 0x112a88>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1608000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x00 0x5fd82200>;
			opp-microvolt = <0xd59f8 0xd59f8 0x112a88>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1800000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0xdbba0 0xdbba0 0x112a88>;
			clock-latency-ns = <0x9c40>;
		};

		opp-1992000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x00 0x76bb8200>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x112a88>;
			clock-latency-ns = <0x9c40>;
		};

		/* 2160MHz OC, per-bin. Measured 2026-09-16 on 72ece2687e9c7853: the
		 * rail (SYR827 at i2c 0-0040, VSEL0 = 712.5mV + n * 12.5mV) was walked
		 * down with the CPU pinned at 2160MHz and the GPU, DMC and VOP pinned
		 * to their top OPPs, two minutes of four-core md5+sha256 per step with
		 * every result checked:
		 *
		 *   1000 .. 862 mV   all clean, 58-61C
		 *   850 mV           clean (floor)
		 *   837 mV           hard reset in under 15s
		 *
		 * so 1.20V was 350mV above where this part fails. L2/L3 take 1.075V,
		 * 225mV of margin; L0/L1 keep the old 1.20V because nothing here has
		 * been measured on a weak part, and every device runs this same tree.
		 * The die picks its own column at boot from its PVTM fuse: this unit
		 * reads 91320 -> L3, the RG DS Plus measured alongside it reads 89650
		 * -> L2 and fails 37.5mV higher, at 875mV. That the bins ordered the
		 * two parts the same way the measurements did is the reason to trust
		 * the split at all - it is still only two units, both upper-bin.
		 *
		 * NOTE this OPP only does anything if the bootloader's ATF carries the
		 * 2160 PLL rate; stock rkbin BL31 does not, and without it the kernel
		 * reports 2160 while the hardware sits at 1992 (see oc/atf-2160-patch.py
		 * in the rg_ds_uboot tree).
		 */
		opp-2160000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = <0x00 0x80befc00>;
			opp-microvolt = <0x124f80 0x124f80 0x124f80>;
			opp-microvolt-L0 = <0x124f80 0x124f80 0x124f80>;
			opp-microvolt-L1 = <0x124f80 0x124f80 0x124f80>;
			opp-microvolt-L2 = <0x106738 0x106738 0x124f80>;
			opp-microvolt-L3 = <0x106738 0x106738 0x124f80>;
			clock-latency-ns = <0x9c40>;
		};
	};

	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cells = <&otp_id &otp_cpu_version &cpu_code &specification_serial_number &remark_spec_serial_number>;
		nvmem-cell-names = "id\0cpu-version\0cpu-code\0specification_serial_number\0remark_spec_serial_number";
	};

	display_subsystem: display-subsystem {
		compatible = "rockchip,display-subsystem";
		memory-region = <&drm_logo &drm_cubic_lut>;
		memory-region-names = "drm-logo\0drm-cubic-lut";
		ports = <&vop_out>;
		devfreq = <0x12>;
		phandle = <0x13d>;

		route {

			route_dsi0: route-dsi0 {
				status = "okay";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x13>;
				phandle = <0x13e>;
			};

			route_dsi1: route-dsi1 {
				status = "okay";
				/* The top panel is mounted turned 180 degrees and scans like the bottom
				 * one (page-1 0x37 = 0x09): rotate the logo and charge animation. */
				logo,rotate = <180>;
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x14>;
				phandle = <0x13f>;
			};

			route_edp: route-edp {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x15>;
				phandle = <0x140>;
			};

			route_hdmi: route-hdmi {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x16>;
				phandle = <0x141>;
			};

			route_lvds: route-lvds {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x17>;
				phandle = <0x142>;
			};

			route_rgb: route-rgb {
				status = "disabled";
				logo,uboot = "logo.bmp";
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				charge_logo,mode = "center";
				connect = <0x18>;
				phandle = <0x143>;
			};
		};
	};

	dmcdbg: dmcdbg {
		compatible = "rockchip,rk3568-dmcdbg";
		status = "disabled";
		phandle = <0x144>;
