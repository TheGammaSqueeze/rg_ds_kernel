	thermal_zones: thermal-zones {
		phandle = <0x1dd>;

		soc_thermal: soc-thermal {
			polling-delay-passive = <0x14>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x389>;
			thermal-sensors = <&tsadc 0x00>;
			phandle = <0x1de>;

			trips {

				threshold: trip-point-0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x1df>;
				};

				target: trip-point-1 {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x104>;
				};

				soc_crit: soc-crit {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x1e0>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x104>;
					cooling-device = <&cpu0 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		gpu_thermal: gpu-thermal {
			polling-delay-passive = <0x14>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&tsadc 0x01>;
			phandle = <0x1e1>;

			trips {

				gpu-threshold {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x331>;
				};

				gpu_crit: gpu-crit {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x1e2>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x331>;
					cooling-device = <&gpu 0xffffffff 0xffffffff>;
				};
			};
		};
	};

	tsadc: tsadc@fe710000 {
		compatible = "rockchip,rk3568-tsadc";
		reg = <0x00 0xfe710000 0x00 0x100>;
		interrupts = <0x00 0x73 0x04>;
		assigned-clocks = <&cru 0x110 &cru 0x111>;
		assigned-clock-rates = <0x1036640 0xaae60>;
		clocks = <&cru 0x111 &cru 0x10f>;
		clock-names = "tsadc\0apb_pclk";
		resets = <&cru 0x182 &cru 0x181 &cru 0x1d7>;
		reset-names = "tsadc\0tsadc-apb\0tsadc-phy";
		rockchip,grf = <&grf>;
		nvmem-cells = <&tsadc_trim_base &tsadc_trim_base_frac>;
		nvmem-cell-names = "trim_base\0trim_base_frac";
		rockchip,hw-tshut-temp = <0x1d4c0>;
		rockchip,hw-tshut-mode = <0x00>;
		rockchip,hw-tshut-polarity = <0x00>;
		pinctrl-names = "gpio\0otpout";
		pinctrl-0 = <&tsadc_gpio_func>;
		pinctrl-1 = <&tsadc_shutorg>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		#thermal-sensor-cells = <0x01>;
		status = "okay";
		phandle = <0x103>;

		tsadc@0 {
			reg = <0x00>;
			nvmem-cells = <&cpu_tsadc_trim_l &cpu_tsadc_trim_h>;
			nvmem-cell-names = "trim_l\0trim_h";
		};

		tsadc@1 {
			reg = <0x01>;
			nvmem-cells = <&gpu_tsadc_trim_l &gpu_tsadc_trim_h>;
			nvmem-cell-names = "trim_l\0trim_h";
		};
	};

