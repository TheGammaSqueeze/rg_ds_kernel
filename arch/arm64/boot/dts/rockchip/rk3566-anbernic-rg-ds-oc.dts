	xpcs: syscon@fda00000 {
		compatible = "rockchip,rk3568-xpcs\0syscon";
		reg = <0x00 0xfda00000 0x00 0x200000>;
		status = "disabled";
		phandle = <0x162>;
	};

	pmugrf: syscon@fdc20000 {
		compatible = "rockchip,rk3568-pmugrf\0syscon\0simple-mfd";
		reg = <0x00 0xfdc20000 0x00 0x10000>;
		phandle = <0x3b>;

		pmu_io_domains: io-domains {
			compatible = "rockchip,rk3568-pmu-io-voltage-domain";
			status = "okay";
			pmuio1-supply = <&vcc3v3_pmu>;
			pmuio2-supply = <&vcc3v3_pmu>;
			vccio1-supply = <&vccio_acodec>;
			vccio3-supply = <&vccio_sd>;
			vccio4-supply = <&vcc_3v3>;
			vccio5-supply = <&vcc_3v3>;
			vccio6-supply = <&vcc_1v8>;
			vccio7-supply = <&vcc_3v3>;
			phandle = <0x163>;
		};

		reboot_mode: reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0x200>;
			mode-bootloader = <0x5242c301>;
			mode-charge = <0x5242c30b>;
			mode-fastboot = <0x5242c309>;
			mode-loader = <0x5242c301>;
			mode-normal = <0x5242c300>;
			mode-recovery = <0x5242c303>;
			mode-ums = <0x5242c30c>;
			mode-panic = <0x5242c307>;
			mode-watchdog = <0x5242c308>;
			phandle = <0x164>;
		};
	};

	pipegrf: syscon@fdc50000 {
		compatible = "rockchip,rk3568-pipe-grf\0syscon";
		reg = <0x00 0xfdc50000 0x00 0x1000>;
		phandle = <0x10e>;
	};

	grf: syscon@fdc60000 {
		compatible = "rockchip,rk3568-grf\0syscon\0simple-mfd";
		reg = <0x00 0xfdc60000 0x00 0x10000>;
		phandle = <0x3a>;

		io_domains: io-domains {
			compatible = "rockchip,rk3568-io-voltage-domain";
			status = "disabled";
			phandle = <0x165>;
		};

		lvds: lvds0: lvds {
			compatible = "rockchip,rk3568-lvds";
			phys = <&video_phy0>;
			phy-names = "phy";
			status = "disabled";
			phandle = <0x166>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					lvds0_in_vp1: lvds_in_vp1: endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <&vp1_out_lvds>;
						status = "disabled";
						phandle = <0x93>;
					};

					lvds0_in_vp2: lvds_in_vp2: endpoint@2 {
						reg = <0x02>;
						remote-endpoint = <&vp2_out_lvds>;
						status = "disabled";
						phandle = <0x95>;
					};
				};
			};
		};

		rgb: rgb {
			compatible = "rockchip,rk3568-rgb";
			pinctrl-names = "default";
			pinctrl-0 = <&lcdc_ctl>;
			status = "disabled";
			phandle = <0x167>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					rgb_in_vp2: endpoint@2 {
						reg = <0x02>;
						remote-endpoint = <&vp2_out_rgb>;
						status = "disabled";
						phandle = <0x96>;
					};
				};
			};
		};

		lvds1: lvds1 {
			compatible = "rockchip,rk3568-lvds";
			phys = <&video_phy1>;
			phy-names = "phy";
			status = "disabled";
			phandle = <0x168>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					lvds1_in_vp1: endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <&vp1_out_lvds1>;
						status = "disabled";
						phandle = <0x94>;
					};

					lvds1_in_vp2: endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <&vp2_out_lvds1>;
						status = "disabled";
						phandle = <0x97>;
					};
				};
			};
		};
	};

	pipe_phy_grf1: syscon@fdc80000 {
		compatible = "rockchip,pipe-phy-grf\0syscon";
		reg = <0x00 0xfdc80000 0x00 0x1000>;
		phandle = <0x10f>;
	};

	pipe_phy_grf2: syscon@fdc90000 {
		compatible = "rockchip,pipe-phy-grf\0syscon";
		reg = <0x00 0xfdc90000 0x00 0x1000>;
		phandle = <0x110>;
	};

	usb2phy0_grf: syscon@fdca0000 {
		compatible = "rockchip,rk3568-usb2phy-grf\0syscon";
		reg = <0x00 0xfdca0000 0x00 0x8000>;
		phandle = <0x112>;
	};

	usb2phy1_grf: syscon@fdca8000 {
		compatible = "rockchip,rk3568-usb2phy-grf\0syscon";
		reg = <0x00 0xfdca8000 0x00 0x8000>;
		phandle = <0x114>;
	};

	edp_phy_grf: syscon@fdcb0000 {
		compatible = "rockchip,rk3568-edp-phy-grf\0syscon\0simple-mfd";
		reg = <0x00 0xfdcb0000 0x00 0x100>;
		clocks = <&cru 0x192>;
		phandle = <0x169>;

		edp_phy: edp-phy {
			compatible = "rockchip,rk3568-edp-phy";
			clocks = <&pmucru 0x29>;
			clock-names = "refclk";
			#phy-cells = <0x00>;
			status = "disabled";
			phandle = <0xaa>;
		};
	};

	sram: sram@fdcc0000 {
		compatible = "mmio-sram";
		reg = <0x00 0xfdcc0000 0x00 0xb000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0xfdcc0000 0xb000>;
		phandle = <0x16a>;

		rkvdec_sram: rkvdec-sram@0 {
			reg = <0x00 0xb000>;
			phandle = <0x79>;
		};
	};

	pmucru: clock-controller@fdd00000 {
		compatible = "rockchip,rk3568-pmucru";
		reg = <0x00 0xfdd00000 0x00 0x1000>;
		rockchip,grf = <&grf>;
		rockchip,pmugrf = <&pmugrf>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		assigned-clocks = <&pmucru 0x32>;
		assigned-clock-parents = <&pmucru 0x05>;
		phandle = <0x39>;
	};

	cru: clock-controller@fdd20000 {
		compatible = "rockchip,rk3568-cru";
		reg = <0x00 0xfdd20000 0x00 0x1000>;
		rockchip,grf = <&grf>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		assigned-clocks = <&pmucru 0x05 &cru 0x106 &cru 0x10b &pmucru 0x01 &pmucru 0x2b &cru 0x03 &cru 0x19b &cru 0x09 &cru 0x19c &cru 0x19d &cru 0x1a1 &cru 0x19e &cru 0x19f &cru 0x1a0 &cru 0x04 &cru 0x10d &cru 0x10e &cru 0x173 &cru 0x174 &cru 0x175 &cru 0x176 &cru 0xc9 &cru 0xca &cru 0x06 &cru 0x7e &cru 0x7f &cru 0x3d &cru 0x41 &cru 0x45 &cru 0x49 &cru 0x4d &cru 0x4d &cru 0x55 &cru 0x51 &cru 0x5d &cru 0xdd>;
		assigned-clock-rates = <0x8000 0x11e1a300 0x11e1a300 0xbebc200 0x5f5e100 0x3b9aca00 0x1dcd6500 0x13d92d40 0xee6b280 0x7735940 0x5f5e100 0x3b9aca0 0x2faf080 0x17d7840 0x46cf7100 0x8f0d180 0x5f5e100 0x1dcd6500 0x17d78400 0x8f0d180 0x5f5e100 0x11e1a300 0x8f0d180 0x47868c00 0x17d78400 0x5f5e100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x46cf7100 0x1dcd6500>;
		assigned-clock-parents = <&pmucru 0x08 &cru 0x04 &cru 0x04>;
		phandle = <0x24>;
	};

	i2c0: i2c@fdd40000 {
		compatible = "rockchip,rk3568-i2c\0rockchip,rk3399-i2c";
		reg = <0x00 0xfdd40000 0x00 0x1000>;
		interrupts = <0x00 0x2e 0x04>;
		clocks = <&pmucru 0x07 &pmucru 0x2d>;
		clock-names = "i2c\0pclk";
		pinctrl-0 = <&i2c0_xfer>;
		pinctrl-names = "default";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x16b>;

		vdd_cpu: sti8070a@40 {
			compatible = "silergy,syr827";
			reg = <0x40>;
			vin-supply = <&vccsys>;
			regulator-compatible = "fan53555-reg";
			regulator-name = "vdd_cpu";
			regulator-min-microvolt = <0xadf34>;
			regulator-max-microvolt = <0x1535b0>;
			regulator-init-microvolt = <0xf4240>;
			regulator-ramp-delay = <0x8fc>;
			fcs,suspend-voltage-selector = <0x01>;
			regulator-boot-on;
			regulator-always-on;
			phandle = <0x05>;

			regulator-state-mem {
				regulator-off-in-suspend;
			};
		};

		rk817: pmic@20 {
			compatible = "rockchip,rk817";
			reg = <0x20>;
			interrupt-parent = <&gpio0>;
			interrupts = <0x03 0x08>;
			pinctrl-names = "default\0pmic-sleep\0pmic-power-off\0pmic-reset";
			pinctrl-0 = <&pmic_int>;
			pinctrl-1 = <&soc_slppin_slp>;
			pinctrl-2 = <&soc_slppin_gpio>;
			pinctrl-3 = <&soc_slppin_gpio>;
			rockchip,system-power-controller;
			wakeup-source;
			#clock-cells = <0x01>;
			clock-output-names = "rk808-clkout1\0rk808-clkout2";
			pmic-reset-func = <0x00>;
			not-save-power-en = <0x01>;
			vcc1-supply = <&vccsys>;
			vcc2-supply = <&vccsys>;
			vcc3-supply = <&vccsys>;
			vcc4-supply = <&vccsys>;
			vcc5-supply = <&vccsys>;
			vcc6-supply = <&vccsys>;
			vcc7-supply = <&vccsys>;
			vcc8-supply = <&vccsys>;
			vcc9-supply = <&dcdc_boost>;
			phandle = <0x139>;

			pwrkey {
				status = "okay";
			};

			pinctrl_rk8xx: pinctrl_rk8xx {
				gpio-controller;
				#gpio-cells = <0x02>;
				phandle = <0x16c>;

				rk817_slppin_null: rk817_slppin_null {
					pins = "gpio_slp";
					function = "pin_fun0";
					phandle = <0x16d>;
				};

				rk817_slppin_slp: rk817_slppin_slp {
					pins = "gpio_slp";
					function = "pin_fun1";
					phandle = <0x16e>;
				};

				rk817_slppin_pwrdn: rk817_slppin_pwrdn {
					pins = "gpio_slp";
					function = "pin_fun2";
					phandle = <0x16f>;
				};

				rk817_slppin_rst: rk817_slppin_rst {
					pins = "gpio_slp";
					function = "pin_fun3";
					phandle = <0x170>;
				};
			};

			regulators {

				vdd_logic: DCDC_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xd59f8>;
					regulator-max-microvolt = <0x149970>;
					regulator-init-microvolt = <0xe7ef0>;
					regulator-ramp-delay = <0x1771>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vdd_logic";
					phandle = <0x6c>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xd59f8>;
					};
				};

				vdd_gpu: DCDC_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xc96a8>;
					regulator-max-microvolt = <0x149970>;
					regulator-init-microvolt = <0xe7ef0>;
					regulator-ramp-delay = <0x1771>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vdd_gpu";
					phandle = <0x6e>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				vcc_ddr: DCDC_REG3 {
					regulator-always-on;
					regulator-boot-on;
					regulator-initial-mode = <0x02>;
					regulator-name = "vcc_ddr";
					phandle = <0x171>;

					regulator-state-mem {
						regulator-on-in-suspend;
					};
				};

				vcc_3v3: DCDC_REG4 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-initial-mode = <0x02>;
					regulator-name = "vcc_3v3";
					phandle = <0x31>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				vcca1v8_pmu: LDO_REG1 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcca1v8_pmu";
					phandle = <0x172>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};

				vdda_0v9: LDO_REG2 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xdbba0>;
					regulator-max-microvolt = <0xdbba0>;
					regulator-name = "vdda_0v9";
					phandle = <0x173>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				vdda0v9_pmu: LDO_REG3 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xdbba0>;
					regulator-max-microvolt = <0xdbba0>;
					regulator-name = "vdda0v9_pmu";
					phandle = <0x174>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xdbba0>;
					};
				};

				vccio_acodec: LDO_REG4 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vccio_acodec";
					phandle = <0x2f>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				vccio_sd: LDO_REG5 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vccio_sd";
					phandle = <0x30>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				vcc3v3_pmu: LDO_REG6 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vcc3v3_pmu";
					phandle = <0x2e>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x2dc6c0>;
					};
				};

				vcc_1v8: LDO_REG7 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-name = "vcc_1v8";
					phandle = <0x32>;

					regulator-state-mem {
						regulator-on-in-suspend;
					};
				};

				vcc1v8_dvp: LDO_REG8 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					regulator-name = "vcc1v8_dvp";
					phandle = <0x175>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				vcc2v8_dvp: LDO_REG9 {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-name = "vcc2v8_dvp";
					phandle = <0x176>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				dcdc_boost: BOOST {
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x4c4b40>;
					regulator-max-microvolt = <0x4c4b40>;
					regulator-name = "boost";
					phandle = <0x42>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};

				otg_switch: OTG_SWITCH {
					regulator-name = "otg_switch";
					phandle = <0x177>;

					regulator-state-mem {
						regulator-off-in-suspend;
					};
				};
			};

			simple_battery: simple-battery {
				compatible = "simple-battery";
				charge-full-design-microamp-hours = <0x2625a0>;
				precharge-current-microamp = <0x2bf20>;
				precharge-upper-limit-microvolt = <0x36ee80>;
				charge-term-current-microamp = <0x493e0>;
				constant-charge-current-max-microamp = <0x989680>;
				constant-charge-voltage-max-microvolt = <0x426030>;
				factory-internal-resistance-micro-ohms = <0x50>;
				voltage-max-design-microvolt = <0x426030>;
				voltage-min-design-microvolt = <0x2dc6c0>;
				phandle = <0x45>;
			};

			battery {
				compatible = "rk817,battery";
				ocv_table = <0xd48 0xe4f 0xe5d 0xe7b 0xe93 0xea5 0xeb1 0xebc 0xeca 0xef2 0xf15 0xf44 0xf6b 0xf8a 0xfc7 0xff3 0x1028 0x105f 0x109b 0x10f2>;
				design_capacity = <0x1097>;
				design_qmax = <0x1097>;
				bat_res = <0x45>;
				sleep_enter_current = <0x96>;
				sleep_exit_current = <0xb4>;
				sleep_filter_current = <0x64>;
				power_off_thresd = <0xdac>;
				zero_algorithm_vol = <0xf0a>;
				max_soc_offset = <0x3c>;
				monitor_sec = <0x05>;
				sample_res = <0x0a>;
				virtual_power = <0x00>;
				status = "okay";
			};

			charger: charger {
				compatible = "rk817,charger";
				min_input_voltage = <0x1194>;
				max_input_current = <0xbb8>;	/* ROCKNIX parity (was 0x5dc/1500); needs a 5V/3A+ charger */
				max_chrg_current = <0xdac>;	/* ROCKNIX parity (was 0x7d0/2000); RK817 hardware max */
				max_chrg_voltage = <0x10fe>;
				chrg_term_mode = <0x02>;
				chrg_finish_cur = <0xc8>;
				virtual_power = <0x00>;
				dc_det_adc = <0x00>;
				extcon = <&usb2phy0>;
				status = "okay";
				phandle = <0x178>;
			};

			rk817_codec: codec {
				#sound-dai-cells = <0x00>;
				compatible = "rockchip,rk817-codec";
				clocks = <&cru 0x1a3>;
				clock-names = "mclk";
				assigned-clocks = <&cru 0x1a3 &cru 0x1a6>;
				assigned-clock-rates = <0xbb8000>;
				assigned-clock-parents = <&cru 0x48 &cru 0x48>;
				pinctrl-names = "default";
				pinctrl-0 = <&i2s1m0_mclk>;
				hp-volume = <0x17>;
				spk-volume = <0x0a>;
				mic-in-differential;
				use-ext-amplifier;
				spk-ctl-gpios = <&gpio4 0x13 0x00>;
				status = "okay";
				phandle = <0x134>;
			};
		};

		cw2015@62 {
			compatible = "cellwise,cw2015";
			reg = <0x62>;
			cellwise,battery-profile = <0x1767816f 0x69656354 0x75505756 0x4e4f4435 0x2c241e1b 0x2432414d 0x1c570b85 0x3454596d 0x85818184 0x3c1b6c6c 0xb411c4d 0x8095a014 0x387e98a3 0x808997cb 0x2f0064a5 0xb5c146ae>;
			cellwise,monitor-interval-ms = <0x1388>;
			monitored-battery = <0x45>;
			battery_id = <0x00>;
			status = "okay";
		};
	};

	uart0: serial@fdd50000 {
		compatible = "rockchip,rk3568-uart\0snps,dw-apb-uart";
		reg = <0x00 0xfdd50000 0x00 0x100>;
		interrupts = <0x00 0x74 0x04>;
		clocks = <&pmucru 0x0b &pmucru 0x2c>;
		clock-names = "baudclk\0apb_pclk";
		dmas = <&dmac0 0x00 &dmac0 0x01>;
		pinctrl-0 = <&uart0_xfer>;
		pinctrl-names = "default";
		reg-io-width = <0x04>;
		reg-shift = <0x02>;
		status = "disabled";
		phandle = <0x179>;
	};

	pwm0: pwm@fdd70000 {
		compatible = "rockchip,rk3568-pwm\0rockchip,rk3328-pwm";
