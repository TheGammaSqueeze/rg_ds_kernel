&sdmmc0 {
	max-frequency = <150000000>;	//GammaOS: UHS-I SDR104 on boot SD (was capped 50MHz)
	//max-frequency = <50000000>;	//GammaOS: raised to SDR104 150MHz above
	supports-sd;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
//    keep-power-in-suspend;
//    card-detect-delay = <800>;
    
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd0>;    //sd vdd
	vqmmc-supply = <&vccio_sd>;  //sd io,VOLTAGE 1.8V--3.3V
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
//	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	status = "okay";
};

//sd or TF
&sdmmc1 {
	max-frequency = <150000000>;
	//max-frequency = <50000000>;
	supports-sd;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
//    keep-power-in-suspend;
    card-detect-delay = <1200>;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd1>;      //sd vdd
	vqmmc-supply = <&vcc1v8_dvp>;  //sd io,VOLTAGE 1.8V--3.3V

	pinctrl-names = "default";
//	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_clk &sdmmc1_cmd &sdmmc1_det>;
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_clk &sdmmc1_cmd>;
	cd-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
	status = "okay";
};

/* sdio wifi */
&sdmmc2 {
	max-frequency = <150000000>; //100000000 
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2m0_bus4 &sdmmc2m0_cmd &sdmmc2m0_clk>;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	rockchip,default-sample-phase = <90>;
	status = "okay";
};

